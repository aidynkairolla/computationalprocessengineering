+import numpy as np
+import matplotlib.pyplot as plt
+from scipy.optimize import newton
+
+# =========================
+# Antoine parameters
+# (DMC, EMC)
+# =========================
+A = np.array([9.3251, 9.2876])
+B = np.array([1348.18, 1388.10])
+C = np.array([-51.1717, -56.8825])
+
+P_total = 101325  # Pa
+
+
+# =========================
+# Antoine
+# =========================
+def p_sat(T):
+    return 10 ** (A - B / (C + T))
+
+
+# =========================
+# Bubble temperature solver
+# =========================
+def bubble_T(x):
+    def f(T):
+        return P_total - np.sum(x * p_sat(T))
+
+    def df(T):
+        ps = p_sat(T)
+        return -np.sum(x * ps * np.log(10) * (B / (C + T)**2))
+
+    T0 = np.dot(x, [363, 390])  # initial guess
+
+    try:
+        return newton(f, T0, fprime=df, tol=1e-6, maxiter=50)
+    except:
+        return None
+
+
+# =========================
+# Vapor composition
+# =========================
+def vapor_y(x, T):
+    ps = p_sat(T)
+    y = x * ps / P_total
+    return y / np.sum(y)
+
+
+# =========================
+# Generate 6 test points
+# =========================
+def generate_points():
+    x_vals = np.linspace(0.05, 0.95, 6)
+
+    T_vals = []
+    y_vals = []
+
+    for x1 in x_vals:
+        x = np.array([x1, 1 - x1])
+
+        T = bubble_T(x)
+        if T is None:
+            continue
+
+        y = vapor_y(x, T)
+
+        T_vals.append(T)
+        y_vals.append(y[0])  # vapor fraction of component 1
+
+    return x_vals, np.array(T_vals), np.array(y_vals)
+
+
+# =========================
+# Plot T-x-y diagram
+# =========================
+def plot_txy(x, T, y):
+    plt.figure(figsize=(7,6))
+
+    # Bubble line
+    plt.plot(x, T, 'o-', label='Bubble line (x)')
+
+    # Dew line
+    plt.plot(y, T, 's-', label='Dew line (y)')
+
+    plt.xlabel('Mole fraction (DMC)')
+    plt.ylabel('Temperature (K)')
+    plt.title('T-x-y Diagram (DMC–EMC)')
+    plt.legend()
+    plt.grid()
+
+    plt.show()
+
+
+# =========================
+# MAIN
+# =========================
+if __name__ == "__main__":
+    x, T, y = generate_points()
+
+    print("x:", x)
+    print("T:", T)
+    print("y:", y)
+
+    plot_txy(x, T, y)
